# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000
SOCKET_PORT=4000
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
DATABASE_URL=mongodb://127.0.0.1:27017/construction

# JWT CONFIGURATION
BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRE_IN=7d
JWT_REFRESH_EXPIRE_IN=30d
ENCRYPTION_KEY=change_me_32_byte_hex_or_strong_secret

# RESET PASSWORD LINK
RESET_PASS_LINK=http://localhost:3000/reset-password
EMAIL=enter_your_email
APP_PASS=enter_your_app_pass
ADMIN_PASS=change_me_strong_admin_password

# STRIPE CONFIGURATION
STRIPE_API_KEY=enter_your_stripe_api_key
STRIPE_API_SECRET=enter_your_stripe_api_secret
PAYMENT_SUCCESS_URL=http://localhost:3000/success
PAYMENT_CANCEL_URL=http://localhost:3000/cancel

# S3 CONFIGURATION
S3_ACCESS_KEY=enter_your_s3_access_key
S3_SECRET_KEY=enter_your_s3_secret_key
S3_ENDPOINT=enter_your_s3_endpoint
S3_REGION=us-east-1
S3_BUCKET_NAME=enter_your_bucket_name
S3_FORCE_PATH_STYLE=true
S3_BASE_URL=enter_your_s3_base_url
